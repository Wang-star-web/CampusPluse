# CampusPulse 环境变量模板（只放变量名，不要真实密钥；复制为 .env 后填写，.env 已被 git 忽略）
# 天气 Web API（Open-Meteo，无需 API Key）
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_LATITUDE=31.23
OPEN_METEO_LONGITUDE=121.47
WEATHER_FORECAST_WINDOW_MIN=30
# 教学覆写：为空时用真实预报；heavy_rain_expected 强制降雨（S3/S4 复现）；unavailable 模拟天气取证失败（S5）
WEATHER_TEACHING_CONDITION=
# 教学覆写：1 时路线工具取证失败（S5 降级演示）
ROUTE_TOOL_TEACHING_UNAVAILABLE=
# 本地知识库目录（相对仓库根）
RAG_KB_DIR=kb
# 外部请求超时（秒）
TOOL_TIMEOUT_S=5
# LLM 解释层（DeepSeek / 任何 OpenAI 兼容 chat/completions；不配置则解释接口返回 503，核心功能不受影响）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
